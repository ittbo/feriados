# Copiar a .env.local y completar con los datos del proyecto de Firebase (dev).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominios habilitados para iniciar sesión, separados por coma.
VITE_ALLOWED_DOMAINS=tbo.group,gobetween.lsp.com

# "true" conecta la app a los emuladores locales de Firebase.
VITE_USE_EMULATORS=true
